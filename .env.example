# ENV EXAMPLE

# SERVER CONFIGURATION
HOST=
GRPC_PORT=
HTTP_PORT=
MAX_WORKERS=
# TLS SETTINGS
TLS_ENABLED=
TLS_KEY_PATH=
TLS_CA_PATH=
TLS_REQUIRE_CLIENT_CERT=

# LOGGING & MONITORING
LOG_LEVEL=
LOG_FORMAT=
LOG_DIR=
SERVICE_NAME=
METRICS_PORT=

# MINIO (OBJECT STORAGE) CONFIGURATION
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=
MINIO_BUCKET_NAME=
OUTPUT_IMAGE_FORMAT=
JPEG_QUALITY=
PNG_COMPRESS_LEVEL=

# REDIS CONFIGURATION
REDIS_URL=

# CELERY CONFIGURATION
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=
CELERY_ENABLE_UTC=

# GPU & AI MODEL CONFIGURATION
# SDXL (~16GB disk): Lykon/dreamshaper-xl-v2-turbo
# Máy ít dung lượng (~6GB): stabilityai/sd-turbo
IMAGE_AI_MODEL_ID=Lykon/dreamshaper-xl-v2-turbo
IMAGE_AI_MODEL_CACHE_DIR=.cache
IMAGE_AI_LOW_VRAM_MODE=False
IMAGE_AI_DEVICE=auto
IMAGE_AI_MODEL_MIN_FREE_DISK_GB=10.0
IMAGE_AI_DEFAULT_WIDTH=768
IMAGE_AI_DEFAULT_HEIGHT=768
IMAGE_AI_DEFAULT_STEPS=4
# CUDA: 0-1.5 cho turbo. MPS: luôn 0 (hoặc dùng MPS_TURBO_GUIDANCE_SCALE)
IMAGE_AI_TURBO_GUIDANCE_SCALE=1.0
IMAGE_AI_MPS_TURBO_GUIDANCE_SCALE=0.0
IMAGE_AI_MPS_USE_FP32=false
IMAGE_AI_MPS_VAE_FP32=false
IMAGE_AI_MPS_DECODE_ON_CPU=true
IMAGE_AI_MPS_ENABLE_SEQUENTIAL_CPU_OFFLOAD=true
IMAGE_AI_MPS_CLEAR_CACHE_AFTER_GENERATE=false
IMAGE_AI_MPS_USE_CPU_GENERATOR=true
IMAGE_AI_MAX_PROMPT_CHARS=280
IMAGE_AI_DISABLE_DIFFUSERS_SAFETY_CHECKER=true
IMAGE_AI_GUIDANCE_SCALE=7.0
IMAGE_AI_OUTPUT_VALIDATION_ENABLED=true
IMAGE_AI_OUTPUT_MIN_MEAN_BRIGHTNESS=8.0
IMAGE_AI_MIN_UPLOAD_BYTES=2048

# STYLE PROMPT
IMAGE_AI_COMIC_STYLE_ENABLED=true
IMAGE_AI_COMIC_STYLE_PROMPT_SUFFIX=children's storybook watercolor illustration, cute semi-chibi children, soft rounded faces, gentle expressive characters, pastel colors, bright airy background, watercolor wash, clean soft ink outlines, storybook comic panel, wholesome playful mood, simple scenic background, sharp focus
IMAGE_AI_DEFAULT_NEGATIVE_PROMPT=photorealistic, realistic photo, 3d render, dark cinematic lighting, blurry, out of focus, low resolution, noisy, jpeg artifacts, dull colors, muddy details, harsh shadows, scary, deformed hands, extra fingers, distorted face, text, watermark, logo

# LORA
IMAGE_AI_LORA_ENABLED=false
IMAGE_AI_LORA_PATH=model/lora/EldritchComicsXL1.2.safetensors
IMAGE_AI_LORA_ADAPTER_NAME=eldritch_comics_xl
IMAGE_AI_LORA_SCALE=0.75
IMAGE_AI_LORA_TRIGGER_WORDS=EldritchComicsXL, colorful comic book illustration, cute children storybook panel
IMAGE_AI_LORA_STRICT_COMPATIBILITY=true
