# ==========================================================================
# ENV EXAMPLE — copy thành .env rồi điền giá trị thật (.env bị gitignore)
# ==========================================================================
# Xem .env thật (không commit) để có ví dụ đầy đủ 4 profile [A]-[D] kèm giải
# thích. File này chỉ liệt kê tên biến + giá trị mẫu, dùng profile [A] (Mac
# dev) làm mặc định.

# ---------- PROFILE ĐANG DÙNG: [A] DEV MAC ----------
IMAGE_AI_ENV=development
IMAGE_AI_MODEL_ID=Lykon/dreamshaper-8-lcm
IMAGE_AI_DEFAULT_STEPS=5
IMAGE_AI_MAX_STEPS=8
IMAGE_AI_DEFAULT_WIDTH=512
IMAGE_AI_DEFAULT_HEIGHT=512
IMAGE_AI_MAX_WIDTH=1024
IMAGE_AI_MAX_HEIGHT=1024
IMAGE_AI_GUIDANCE_SCALE=7.0
IMAGE_AI_IP_ADAPTER_ENABLED=false
IMAGE_AI_IP_ADAPTER_SCALE=0.6
IMAGE_AI_SAFETY_CHECKER_ENABLED=false
IMAGE_AI_MAX_PROMPT_CHARS=800

# ---------- SYSTEM CORE ----------
IMAGE_AI_HOST=0.0.0.0
IMAGE_AI_GRPC_PORT=50051
IMAGE_AI_HTTP_PORT=8000
IMAGE_AI_MAX_WORKERS=4
IMAGE_AI_TLS_ENABLED=False
IMAGE_AI_TLS_CERT_PATH=certs/image-ai-server.crt
IMAGE_AI_TLS_KEY_PATH=certs/image-ai-server.key
IMAGE_AI_TLS_CA_PATH=certs/ca.crt
IMAGE_AI_TLS_REQUIRE_CLIENT_CERT=False

# ---------- LOGGING & MONITORING ----------
IMAGE_AI_LOG_LEVEL=INFO
IMAGE_AI_LOG_DIR=logs
IMAGE_AI_SERVICE_NAME=image-ai
IMAGE_AI_METRICS_PORT=9107

# ---------- CACHE TTL ----------
IMAGE_AI_PRESIGNED_TTL_SECONDS=604800
IMAGE_AI_REDIS_CACHE_TTL_SECONDS=604800
IMAGE_AI_CACHE_KEY_VERSION=v8

# ---------- MINIO (OBJECT STORAGE) ----------
IMAGE_AI_MINIO_ENDPOINT=127.0.0.1
IMAGE_AI_MINIO_PORT=9000
IMAGE_AI_MINIO_ACCESS_KEY=minioadmin
IMAGE_AI_MINIO_SECRET_KEY=minioadmin
IMAGE_AI_MINIO_USE_SSL=False
IMAGE_AI_MINIO_BUCKET_NAME=comic-images
IMAGE_AI_OUTPUT_IMAGE_FORMAT=jpeg
IMAGE_AI_JPEG_QUALITY=95
IMAGE_AI_PNG_COMPRESS_LEVEL=4

# ---------- REDIS / CELERY ----------
IMAGE_AI_REDIS_URL=redis://localhost:6379/0
IMAGE_AI_CELERY_BROKER_URL=redis://localhost:6379/0
IMAGE_AI_CELERY_RESULT_BACKEND=redis://localhost:6379/0
IMAGE_AI_CELERY_TASK_TIME_LIMIT=600
IMAGE_AI_CELERY_TASK_SOFT_TIME_LIMIT=540

# ---------- GENERATIVE AI ENGINE (chung, không phụ thuộc profile) ----------
IMAGE_AI_LOW_VRAM_MODE=false
IMAGE_AI_DEVICE=auto
IMAGE_AI_MODEL_MIN_FREE_DISK_GB=10.0
IMAGE_AI_MIN_STEPS=1
IMAGE_AI_CAPTION_MAX_LENGTH=500

# ---------- APPLE SILICON (MPS) ----------
IMAGE_AI_MPS_TURBO_GUIDANCE_SCALE=0.0
IMAGE_AI_MPS_USE_FP32=false
IMAGE_AI_MPS_VAE_FP32=true
IMAGE_AI_MPS_DECODE_ON_CPU=true
IMAGE_AI_MPS_ENABLE_SEQUENTIAL_CPU_OFFLOAD=false
IMAGE_AI_MPS_CLEAR_CACHE_AFTER_GENERATE=false
IMAGE_AI_MPS_USE_CPU_GENERATOR=true

# ---------- OUTPUT & SAFETY ----------
IMAGE_AI_DISABLE_DIFFUSERS_SAFETY_CHECKER=true
IMAGE_AI_OUTPUT_VALIDATION_ENABLED=true
IMAGE_AI_OUTPUT_MIN_MEAN_BRIGHTNESS=8.0
IMAGE_AI_MIN_UPLOAD_BYTES=2048
IMAGE_AI_LCM_GUIDANCE_SCALE=1.5

# ---------- PROMPT ENGINEERING & STYLE ----------
IMAGE_AI_COMIC_STYLE_ENABLED=true
IMAGE_AI_COMIC_STYLE_PROMPT_SUFFIX=whimsical fable book illustration, highly detailed, vibrant colors, fantasy art style
IMAGE_AI_DEFAULT_NEGATIVE_PROMPT=ugly, blurry, low quality, pixelated, jpeg artifacts, photorealistic, 3d render, dark, scary, deformed hands, extra fingers, bad anatomy, distorted face, text, watermark, logo, nsfw, comic strip, panel grid, multiple panels, split screen, collage, reference sheet, multiple views

# ---------- LORA ----------
IMAGE_AI_LORA_ENABLED=false
IMAGE_AI_LORA_PATH=model/lora/EldritchComicsXL1.2.safetensors
IMAGE_AI_LORA_ADAPTER_NAME=eldritch_comics_xl
IMAGE_AI_LORA_SCALE=0.75
IMAGE_AI_LORA_TRIGGER_WORDS=EldritchComicsXL, comic illustration
IMAGE_AI_LORA_STRICT_COMPATIBILITY=true

# ---------- POST PROCESSING ----------
IMAGE_AI_CAPTION_RENDER_ENABLED=false
IMAGE_AI_COMIC_POSTPROCESS_ENABLED=true
IMAGE_AI_SHARPEN_RADIUS=1.1
IMAGE_AI_SHARPEN_PERCENT=135
IMAGE_AI_SHARPEN_THRESHOLD=3
IMAGE_AI_COLOR_BOOST=1.08
IMAGE_AI_CONTRAST_BOOST=1.05
